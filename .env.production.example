# Copier en .env à la racine du dépôt, sur le serveur.
# docker compose lit automatiquement ce fichier pour docker-compose.prod.yml.
# Il ne doit jamais être versionné.

# Domaine public du site, sans protocole.
APP_DOMAIN=pokedata.exemple.fr

# Mot de passe PostgreSQL. Utiliser une valeur hexadécimale pour qu'elle soit
# sûre dans DATABASE_URL : openssl rand -hex 32
POSTGRES_PASSWORD=

# Secret Better Auth, 32 caractères minimum, différent du développement.
# Générer avec : openssl rand -hex 32
BETTER_AUTH_SECRET=

# Jeton du tunnel Cloudflare, fourni au moment de sa création dans le dashboard.
# Il ne doit jamais être copié dans le dépôt, une issue ou une commande shell.
TUNNEL_TOKEN=
