# Copier en .env pour le développement local.
# En production, les variables sont fournies par docker-compose.prod.yml.

# Base PostgreSQL locale, démarrée par `pnpm db:start` (port hôte 5433).
DATABASE_URL=postgresql://postgres:password@localhost:5433/pokedata

# 32 caractères minimum. Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Sans slash final : Better Auth compose les URL de rappel à partir de cette valeur.
BETTER_AUTH_URL=http://localhost:3001
